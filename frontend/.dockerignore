# Dockerignore específico para o frontend

# Dependências (serão instaladas no container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (serão gerados no container)
.next/
out/
dist/
build/

# Cache
.cache/

# Logs
*.log

# Arquivos temporários
*.tmp
*.temp

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Testes
coverage/
.nyc_output/


# Banco de dados
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/chatbot

# JWT (Autenticação)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Flutterwave (Pagamentos)
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key-here
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key-here
FLUTTERWAVE_SANDBOX=true

# Frontend URL para redirecionamentos
FRONTEND_URL=http://localhost:3000
